# Cloudflare Pages holds scripts for four hours, which is right for the stamped
# ones and wrong for the manifest, which carries no stamp and is read at install
# time. The worker wants the same treatment and cannot have it — Pages keeps its
# own TTL on anything .js whatever this file says, which is why the worker is
# registered with the commit in its URL instead. See deploy.sh.
/manifest.webmanifest
  Cache-Control: no-cache
